# used for settings, copy to a file named .env and change the values
GOOGLE_API_KEY=your-google-api-key
GOOGLE_MODEL_NAME=gemini-3.5-flash-lite
# Used only by the google_search agents (02, 03, 05, 12); free-tier keys only allow search grounding on it
GOOGLE_SEARCH_MODEL_NAME=gemini-2.5-flash
# Used only by the PlanReActPlanner agent in 18; lite models write its tool calls as text
GOOGLE_PLANNER_MODEL_NAME=gemini-3.5-flash

# Required only for 09_litellm.py (OpenAI via LiteLLM)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL_NAME=openai/gpt-4o-mini
